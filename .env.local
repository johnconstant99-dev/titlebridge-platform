# TitleBridge Production Environment Configuration
# Copy .env.example to .env.local and fill in the values below
# NEVER commit .env.local to Git (already in .gitignore)

# ============================================================================
# DATABASE (Required in production, optional in development)
# ============================================================================
# Leave empty for local development (uses in-memory PGLite)
# Set to Neon connection string for production
# Format: postgresql://user:password@host/dbname?sslmode=require
# 
# Get from: https://console.neon.tech → Copy connection string
DATABASE_URL=

# ============================================================================
# BETTER AUTH - Session & Authentication Signing
# ============================================================================
# Required in production. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 
# This signs session cookies. Must be 32+ random hex characters.
# NEVER reuse the same secret across environments.
BETTER_AUTH_SECRET=

# Origin for auth callbacks (your app domain)
# Local: http://localhost:8080
# Production: https://app.titlebridge.com
BETTER_AUTH_URL=http://localhost:8080

# ============================================================================
# EMAIL DELIVERY (Required for password resets)
# ============================================================================
# Provider: "resend" (recommended), "sendgrid", "aws-ses", "mailgun"
EMAIL_PROVIDER=resend

# API key from your email provider
# Resend: https://resend.com → API Keys → Copy token
# SendGrid: https://app.sendgrid.com → Settings → API Keys → Create
EMAIL_PROVIDER_KEY=

# Sender email address (e.g., noreply@titlebridge.com)
EMAIL_FROM=noreply@titlebridge.com

# ============================================================================
# AUTH BROKER (Optional - for Google/X sign-in via broker)
# ============================================================================
# Only needed if using Grok auth broker for federated sign-in
# Get from: Grok platform credentials dashboard
GROK_AUTH_ISSUER=
GROK_AUTH_CLIENT_ID=
GROK_AUTH_CLIENT_SECRET=

# ============================================================================
# FEATURE FLAGS
# ============================================================================
# Enable/disable authentication UI (default: true)
# Set to "false" to disable sign-in/sign-up (dev-only)
VITE_AUTH_ENABLED=true

# ============================================================================
# MONITORING & LOGGING (Optional)
# ============================================================================
# Log level: debug, info (default), warn, error
LOG_LEVEL=info

# Sentry DSN for error tracking (optional)
# Get from: https://sentry.io → Project → Settings → Client Keys
SENTRY_DSN=

# ============================================================================
# REFERENCE: Where These Are Used
# ============================================================================
# DATABASE_URL:
#   - src/lib/db.ts: PostgreSQL connection for production
#   - scripts/migrate.mjs: Run migrations on deploy
#   - Better Auth: Session storage
#
# BETTER_AUTH_SECRET:
#   - src/lib/auth/server.ts: Sign session cookies
#   - Required in production (Vercel will enforce)
#
# BETTER_AUTH_URL:
#   - src/lib/auth/server.ts: OAuth callback origin
#   - Must match your app domain
#
# EMAIL_PROVIDER + EMAIL_PROVIDER_KEY:
#   - src/server/email.ts: Send password reset emails
#   - src/lib/auth/server.ts: Integration with Better Auth
#
# GROK_AUTH_*:
#   - src/lib/auth/providers.ts: Google/X via broker
#   - Optional; leave empty to disable federated sign-in
#
# VITE_AUTH_ENABLED:
#   - src/lib/auth/server.ts: Show/hide sign-in UI
#
# LOG_LEVEL:
#   - src/lib/logging.ts: Filter logs by severity
#
# SENTRY_DSN:
#   - Future: Error tracking integration
