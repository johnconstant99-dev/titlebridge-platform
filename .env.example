# TitleBridge Phase 1B Private Beta — environment template
# Copy to .env.local for local work. Never commit real values.
# Hosted production (Vercel / grok.me) injects these; do not write a .env in the App Builder sandbox.

# Persistent Postgres. Required in hosted production. Unset in local/preview → in-memory PGLite.
DATABASE_URL=

# Better Auth session signing. Required in hosted production.
BETTER_AUTH_SECRET=

# Public origin for auth callbacks. Injected on deploy (https://your-app.grok.me).
BETTER_AUTH_URL=

# Grok auth broker (Google / X). Injected on deploy.
GROK_AUTH_ISSUER=
GROK_AUTH_CLIENT_ID=
GROK_AUTH_CLIENT_SECRET=

# Optional. Set to "false" to force auth off (preview-only; deployed auth is always on).
# VITE_AUTH_ENABLED=true
